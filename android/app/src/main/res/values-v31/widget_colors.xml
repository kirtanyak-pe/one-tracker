     wallpaper like the app does by default. -->
<resources>
    <color name="widget_canvas">@android:color/system_neutral1_50</color>
    <color name="widget_tray">@android:color/system_neutral2_100</color>
    <color name="widget_card">@android:color/system_neutral1_10</color>
    <color name="widget_ink">@android:color/system_neutral1_900</color>
    <color name="widget_muted">@android:color/system_neutral2_700</color>
    <color name="widget_accent">@android:color/system_accent1_600</color>
    <color name="widget_error">#B3261E</color>
</resources>
